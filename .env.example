# make dev explicitly uses demo + localhost. app.run defaults to live and HTTPS.
SMARTI_MODE=live
SMARTI_HA_URL=http://homeassistant.local:8123
# Long-lived HA token, only on backend. Needs registry permissions (admin for initial version).
SMARTI_HA_TOKEN=
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Share with the owner through a protected installer channel, remove after setup.
SMARTI_BOOTSTRAP_SECRET=
SMARTI_ORIGIN=https://192.168.1.50:8443
# Optional JSON list of additional exact browser origins
SMARTI_ADDITIONAL_ORIGINS=[]
SMARTI_DATA_DIR=.data
SMARTI_TLS_CERT=/path/to/trusted-server.crt
SMARTI_TLS_KEY=/path/to/private-server.key
# SMARTI_DEVELOPMENT=true only with explicit localhost origin. Never use on LAN.

# Local mobile pilot only. Separate HTTPS listener; disabled by default.
SMARTI_MOBILE_ENABLED=false
SMARTI_MOBILE_URL=
